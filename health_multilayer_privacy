        "def quality_check(answer):\n",
        "    # Giskard Logic: பதில் ரொம்ப சின்னதா இருந்தா அது தப்புனு சொல்லும்\n",
        "    if len(answer) < 10:\n",
        "        return \"❌ Quality Check Failed: Answer too short\"\n",
        "\n",
        "    # Fiddler Logic: பதிலில் தப்பான வார்த்தைகள் இருக்கான்னு பார்க்கும் (Drift Monitoring)\n",
        "    forbidden_words = [\"don't know\", \"error\", \"null\"]\n",
        "    if any(word in answer.lower() for word in forbidden_words):\n",
        "        return \"⚠️ Monitoring Alert: Low confidence answer\"\n",
        "\n",
        "    return \"✅ Quality Passed\""
      ],
