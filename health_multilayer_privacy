        "def run_healthcare_ai(user_query):\n",
        "    # 1. Logging Start\n",
        "    log_activity(\"Input Received\", user_query)\n",
        "\n",
        "    # 2. Presidio - Security\n",
        "    masked_query = secure_shield(user_query)\n",
        "    log_activity(\"Security Check (Presidio)\", f\"Masked: {masked_query}\")\n",
        "\n",
        "    # 3. AI Processing (இங்கதான் உன் பழைய RAG கோடு வரும்)\n",
        "    # இப்போதைக்கு ஒரு சாம்பிள் பதில்:\n",
        "    ai_response = \"The patient should take Metformin for Type 2 Diabetes.\"\n",
        "\n",
        "    # 4. Giskard & Fiddler - Quality Check\n",
        "    status = quality_check(ai_response)\n",
        "    log_activity(\"Quality Control\", status)\n",
        "\n",
        "    return f\"Final Answer: {ai_response}\\nStatus: {status}\"\n",
        "\n",
